# Reddit API Credentials
# Register your app at: https://www.reddit.com/prefs/apps
REDDIT_CLIENT_ID=your_client_id_here
REDDIT_CLIENT_SECRET=your_client_secret_here
REDDIT_USER_AGENT=SentimentAnalyzer/1.0 by /u/your_username

# App Settings
USE_MOCK_DATA=true        # Set to false when you have real credentials
MAX_POSTS_PER_SEARCH=100
CACHE_TTL_MINUTES=30

# Server Settings
HOST=0.0.0.0
PORT=8000
